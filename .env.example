# Copy to .env.local and fill in. .env.local is git-ignored; this file is committed.
# Restart `npm run dev` after changing it. Full walkthrough: docs/SETUP.md

# --- Supabase (Project Settings → API) -------------------------------------
# Without these the shop reads src/data/* and /admin shows setup instructions.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…). The legacy anon key also works, as NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_…, Project Settings → API Keys). SERVER-ONLY: never NEXT_PUBLIC_.
# Used for guest checkout and payment confirmation. The legacy service_role key also works,
# as SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# --- Razorpay (Dashboard → Account & Settings → API Keys) -------------------
# Start with Test Mode keys (rzp_test_…); swap to live keys after KYC.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhooks → Add: URL https://<your-site>/api/razorpay/webhook,
# events payment.captured, order.paid, payment.failed. Paste the secret you chose here.
RAZORPAY_WEBHOOK_SECRET=

# --- Direct UPI (used while Razorpay isn't set up) --------------------------
# Your UPI ID (from PhonePe / Google Pay / Paytm / your bank app), e.g. maatiliving@ybl.
# With this + SUPABASE_SECRET_KEY and no Razorpay keys, checkout saves the order and shows
# a UPI QR / pay link; you confirm each payment in /admin → Orders → UPI to verify.
NEXT_PUBLIC_UPI_ID=
# Name shown to the customer in their UPI app (should match the bank account holder)
NEXT_PUBLIC_UPI_PAYEE_NAME=Maati Living

# --- Order emails over SMTP (Hostinger mailbox) -----------------------------
# Order placed / payment confirmed / shipped emails. Leave all blank to switch emails off (orders still work).
# Hostinger: smtp.hostinger.com, port 465 (SSL). SMTP_USER is the full mailbox address; SMTP_PASS its password.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
# SERVER-ONLY. The mailbox password (Hostinger hPanel → Emails → the mailbox → Change password).
SMTP_PASS=
# Must be the same mailbox as SMTP_USER, e.g. "Maati Living <contact@maatiliving.co.in>"
MAIL_FROM=
# Where new-order and "UPI payment to check" alerts go (your inbox)
ORDER_NOTIFY_EMAIL=
# Public URL used in email links, canonical tags and the sitemap (http://localhost:3000 in development;
# https://www.maatiliving.co.in in production)
NEXT_PUBLIC_SITE_URL=

# --- Cloudinary (Console → Settings → API Keys) ----------------------------
# Images fall back to CSS textile placeholders when the cloud name is empty.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Needed for photo uploads in /admin. The API key is public; the SECRET must never be NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Contact -----------------------------------------------------------------
# TODO: WhatsApp business number — digits only, with country code (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Instagram profile URL (defaults to https://instagram.com/maatiliving)
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/maatiliving

# TODO: public contact email
NEXT_PUBLIC_CONTACT_EMAIL=
