# Copy to .env.local and fill in. .env.local is git-ignored; this file is committed.
# Restart `npm run dev` after changing it. Full walkthrough: docs/SETUP.md

# --- Supabase (Project Settings → API) -------------------------------------
# Without these the shop reads src/data/* and /admin shows setup instructions.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Cloudinary (Console → Settings → API Keys) ----------------------------
# Images fall back to CSS textile placeholders when the cloud name is empty.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Needed for photo uploads in /admin. The API key is public; the SECRET must never be NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Contact -----------------------------------------------------------------
# TODO: WhatsApp business number — digits only, with country code (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Instagram profile URL (defaults to https://instagram.com/maatiliving)
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/maatiliving

# TODO: public contact email
NEXT_PUBLIC_CONTACT_EMAIL=
